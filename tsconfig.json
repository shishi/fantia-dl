{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "types": ["chrome", "vitest/globals"],
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}
